rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /phone_information/{infoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /app_notifications/{notificationId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /admin_feedback/{messageId} {
      allow read, create: if request.auth != null;
      allow delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
      allow update: if false;
    }
    match /admin_push_tokens/{tokenId} {
      allow read, create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3"
        && tokenId == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /registered_devices/{deviceId} {
      allow create, update: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.device_id == deviceId
        && request.resource.data.keys().hasOnly([
          "uid", "device_id", "manufacturer", "model", "device",
          "android_version", "sdk_int", "app_version", "first_seen", "last_seen"
        ])
        && request.resource.data.manufacturer is string
        && request.resource.data.model is string
        && request.resource.data.device is string
        && request.resource.data.android_version is string
        && request.resource.data.sdk_int is number
        && request.resource.data.app_version is string
        && request.resource.data.first_seen is number
        && request.resource.data.last_seen is timestamp;
      allow read, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /group_messages/{messageId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(["uid", "nickname", "text", "created_at"])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.nickname is string
        && request.resource.data.nickname.size() >= 2
        && request.resource.data.nickname.size() <= 24
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.created_at is timestamp;
      allow update: if false;
      allow delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
  }
}