rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /site_settings/{settingId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /posts/{postId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /phone_information/{infoId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
    match /programs/{programId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null
        && request.auth.uid == "FflCErahavNIb8ZXsvHIyrxZYZH3";
    }
  }
}